{
  "name": "nindova-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/session",
    "apps/site"
  ],
  "scripts": {
    "build": "npm run build:session && npm run build:site && node scripts/compose-build.mjs",
    "build:session": "npm --workspace @nindova/session run build",
    "build:site": "npm --workspace @nindova/site run build",
    "check": "npm run typecheck && npm run test:unit && npm run build",
    "dev:session": "npm --workspace @nindova/session run dev",
    "dev:site": "npm --workspace @nindova/site run dev",
    "preview": "node scripts/serve.mjs dist",
    "test": "npm run test:unit && npm run test:arc && npm run test:portrait && npm run test:self-closing && npm run test:night && npm run test:dawn",
    "test:arc": "node tests/browser/seed-asserted.mjs",
    "test:portrait": "node tests/browser/portrait-accessibility.mjs",
    "test:self-closing": "node tests/browser/self-closing.mjs",
    "test:night": "node tests/browser/night-memory.mjs",
    "test:dawn": "npm run build && node tests/browser/dawn.mjs",
    "test:seed:observe": "node scripts/run-seed-observational.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "typecheck": "npm --workspace @nindova/session run typecheck && npm --workspace @nindova/site run typecheck"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "typescript": "6.0.3"
  }
}
