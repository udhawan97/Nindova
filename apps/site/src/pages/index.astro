---
import "../styles/global.css";
import publicFacts from "../../../../public-facts.json";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (path: string) => `${base}${path}` || "/";
const {
  canonicalSiteUrl,
  sourceUrl,
  releaseHistoryUrl,
  latestRelease,
} = publicFacts;
const socialImageUrl = new URL("brand/nindova-og.png", canonicalSiteUrl).href;
const tables = [
  ["I", "Pattern Court", "Read the order beneath the ornament."],
  ["II", "Mirror Forge", "Turn forms without losing their bearing."],
  ["III", "Stack Architect", "Move the tower by law, one disc at a time."],
  ["IV", "Lantern Ledger", "Hold an ordered procession of light."],
  ["V", "Sector Sprint", "Follow Gurpreet and Harjit through five fixed Chandigarh Acts."],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; base-uri 'self'; object-src 'none'; connect-src 'self'; img-src 'self' data:; media-src 'self' blob:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    />
    <meta name="description" content="Nindova is a private house of five authored games for adults, with a separate self-ending Night Room." />
    <meta property="og:title" content="Nindova — A house of authored games" />
    <meta property="og:description" content="Choose a room. Stay for the pleasure of solving. No account, public ranking, or telemetry." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalSiteUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonicalSiteUrl} />
    <link rel="icon" href={href("/brand/favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={href("/brand/favicon-32.png")} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={href("/brand/apple-touch-icon.png")} />
    <title>Nindova — A house of authored games</title>
  </head>
  <body class="landing">
    <a class="skip-link" href="#main">Skip to Nindova</a>
    <header class="site-nav" aria-label="Primary navigation">
      <a class="brand" href={href("/")} aria-label="Nindova home">
        <picture class="brand-lockup-picture">
          <source media="(prefers-reduced-motion: reduce)" srcset={href("/brand/nindova-logo-horizontal.svg")} />
          <img class="brand-lockup" src={href("/brand/nindova-logo-horizontal-animated.svg")} alt="" width="202" height="64" />
        </picture>
      </a>
      <nav class="nav-links" aria-label="Site">
        <a href="#inside">Inside</a>
        <a href="#night-room">Night Room</a>
        <a href="#downloads">Downloads</a>
        <a href={href("/docs/")}>Docs</a>
        <a class="nav-enter" href={href("/house/")}>Enter the House</a>
      </nav>
    </header>

    <main id="main">
      <section class="house-hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">A private house of authored games · adults 18+</p>
          <h1 id="hero-title">Choose a room.<br /><em>Stay for the pleasure of solving.</em></h1>
          <p class="hero-lede">
            Five finite games live in the Grand Salon. A separate Night Room holds Masala Mound,
            a calm Session with an ending it cannot bargain away.
          </p>
          <div class="hero-actions">
            <a class="button-primary" href={href("/house/")}>Enter Nindova House</a>
            <a class="button-secondary" href={href("/play/")}>Visit the Night Room</a>
          </div>
          <p class="source-note">Live web build · no account · no comparison · no app telemetry</p>
        </div>

        <figure class="house-proof">
          <div class="proof-frame">
            <img
              src={href("/media/nindova-house.png")}
              width="1440"
              height="937"
              alt="The real Nindova House floor plan, with the Night Room, five Grand Salon tables, and local Gallery."
            />
          </div>
          <figcaption>Current House floor plan · rendered from source</figcaption>
        </figure>
      </section>

      <aside class="trust-rail" aria-label="Nindova at a glance">
        <p><strong>Five</strong><span>authored Salon tables</span></p>
        <p><strong>Finite</strong><span>chapters and curtain calls</span></p>
        <p><strong>Local</strong><span>browser storage only</span></p>
        <p><strong>Separate</strong><span>bounded Night Room</span></p>
      </aside>

      <section id="inside" class="salon-section" aria-labelledby="salon-title">
        <header class="section-heading">
          <div>
            <p class="eyebrow">The centre of the House</p>
            <h2 id="salon-title">Five tables.<br />Five clean endings.</h2>
          </div>
          <p>
            Each game unfolds across five fixed chapters or Acts. Challenge can deepen inside the table;
            nothing becomes a public ranking, streak, randomized prize, or population comparison.
          </p>
        </header>

        <ol class="table-directory">
          {tables.map(([number, title, line]) => (
            <li>
              <span class="table-number">{number}</span>
              <h3>{title}</h3>
              <p>{line}</p>
              <a class="table-action" href={href("/house/")} aria-label={`Open ${title} in Nindova House`}>
                Open in the House
              </a>
            </li>
          ))}
        </ol>

        <article class="sector-proof">
          <figure>
            <img
              src={href("/media/sector-sprint.png")}
              width="1280"
              height="619"
              alt="Sector Sprint's real cinematic code-drawn Chandigarh route with Gurpreet and Harjit, expressive movement controls, an Act-local tool, and a fixed authored Act."
              loading="lazy"
            />
            <figcaption>Sector Sprint · current source · original code-drawn action theatre</figcaption>
          </figure>
          <div>
            <p class="eyebrow">Table V · Sector Sprint</p>
            <h3>A city route that knows when to close.</h3>
            <p>
              The street moves forward on its own through five Chandigarh Acts. Variable leaps, air step,
              dash/vault/stomp movement, five harmless Act-local tools, and temporary effects change the
              choreography, not a score. Reduced motion begins with the complete narrated route.
            </p>
            <p class="honesty-note">No endless route, health, lives, failure loop, persistent inventory, imported game art, or claim that play makes a person sleepy.</p>
          </div>
        </article>
      </section>

      <section id="night-room" class="night-section" aria-labelledby="night-title">
        <div class="night-copy">
          <p class="eyebrow">The north wing · a deliberately separate loop</p>
          <h2 id="night-title">One quiet rule.<br />One Session, then rest.</h2>
          <p>
            Pair matching kitchen Tiles only when nothing covers them and one side is open. Gentle and Deeper
            are equal tonight-only preferences. Every legal choice keeps a path to the ending, and help points
            to a safe pair without playing it.
          </p>
          <ul>
            <li>No score, visible timer, streak, grade, collection, or randomized reward.</li>
            <li>The Session settles itself before its hidden fifteen-minute ceiling.</li>
            <li>Dawn returns locally in the morning only if the person comes back.</li>
          </ul>
          <a class="text-link" href={href("/play/")}>Enter the Night Room <span aria-hidden="true">→</span></a>
        </div>
        <div class="night-proof">
          <figure class="board-proof">
            <img
              src={href("/media/rasoi-board.png")}
              width="840"
              height="476"
              alt="The real Deeper Masala Mound board with four overlapping layers of labeled Indian kitchen Tiles."
              loading="lazy"
            />
            <figcaption>Masala Mound · real Deeper board</figcaption>
          </figure>
          <figure class="dawn-proof">
            <img
              src={href("/media/rasoi-dawn.png")}
              width="1200"
              height="750"
              alt="The real Dawn canvas, with nine kitchen forms resting on brass plates in first light."
              loading="lazy"
            />
            <figcaption>Dawn · local first-light keepsake</figcaption>
          </figure>
        </div>
      </section>

      <section id="trust" class="trust-section" aria-labelledby="trust-title">
        <header>
          <p class="eyebrow">The House rules</p>
          <h2 id="trust-title">Pleasure, privacy,<br />and a clean exit.</h2>
        </header>
        <dl class="trust-ledger">
          <div><dt>Authored</dt><dd>Every chapter, Act, and outcome is fixed by design. There are no random prizes.</dd></div>
          <div><dt>Private</dt><dd>House and Night data stay in separate local browser records. Nothing is sent by the app.</dd></div>
          <div><dt>Honest</dt><dd>Entertainment play is not presented as a cognitive, educational, sleep, or clinical assessment.</dd></div>
          <div><dt>Accessible</dt><dd>Native controls, visible text, keyboard paths, reduced motion, and alternate narration carry required actions.</dd></div>
        </dl>
        <p class="trust-limit">
          The Punjabi-inspired art direction has not completed human cultural-authenticity review. Real-device
          VoiceOver and TalkBack acceptance, broader installed Safari/Android proof, and human outcome testing remain open.
        </p>
      </section>

      <section id="downloads" class="download-section" aria-labelledby="download-title">
        <header class="section-heading">
          <div>
            <p class="eyebrow">Start your way</p>
            <h2 id="download-title">Open live.<br />Keep a file. Build the source.</h2>
          </div>
          <p>
            The current House is live from <code>main</code>. The latest tagged release is {latestRelease.tag} — {latestRelease.name}{" "}
            and packages the earlier Night Room, not the later Grand Salon.
          </p>
        </header>

        <div class="download-ledger">
          <a href={href("/house/")}>
            <img src={href("/brand/favicon.svg")} width="40" height="40" alt="" />
            <span><strong>Enter Nindova House</strong><small>Current live web app and installable PWA</small></span>
            <em>Open</em>
          </a>
          <a href={href("/play/")}>
            <img src={href("/brand/motifs/chai.svg")} width="40" height="40" alt="" />
            <span><strong>Visit the Night Room</strong><small>Current live Masala Mound PWA</small></span>
            <em>Open</em>
          </a>
          <a href={href("/nindova.html")} download>
            <img src={href("/brand/motifs/katori.svg")} width="40" height="40" alt="" />
            <span><strong>Keep the current Night Room</strong><small>Source-built standalone HTML · no service worker</small></span>
            <em>HTML</em>
          </a>
          <a href={latestRelease.standaloneUrl}>
            <img src={href("/brand/nindova-mark-monochrome.svg")} width="40" height="40" alt="" />
            <span><strong>Download standalone {latestRelease.tag}</strong><small>Portable Night Room HTML · no service worker</small></span>
            <em>HTML</em>
          </a>
          <a href={latestRelease.webBundleUrl}>
            <img src={href("/brand/motifs/tiffin.svg")} width="40" height="40" alt="" />
            <span><strong>Download static {latestRelease.tag} archive</strong><small>Earlier landing, docs, Night PWA, and standalone file</small></span>
            <em>ZIP</em>
          </a>
          <a href={sourceUrl}>
            <img src={href("/brand/nindova-mark.svg")} width="40" height="40" alt="" />
            <span><strong>Build current source</strong><small>Node.js 24+ · House, Night, docs, and standalone output</small></span>
            <em>GitHub</em>
          </a>
        </div>
        <p class="download-note">
          <a href={latestRelease.checksumsUrl}>Verify tagged files with SHA-256</a> · HTML and ZIP files are not native signed or notarized apps ·
          <a href={href("/docs/downloads/")}>Read the complete download guide</a>
        </p>
      </section>

      <section class="help-section" aria-labelledby="help-title">
        <p class="eyebrow">Continue with confidence</p>
        <h2 id="help-title">Read the contract.<br />See the limits.</h2>
        <div class="help-links">
          <a href={href("/docs/getting-started/")}><strong>Getting started</strong><span>Run the House, Night Room, docs, and standalone file.</span></a>
          <a href={href("/docs/product-contract/")}><strong>Product contract</strong><span>The promises neither loop may weaken.</span></a>
          <a href={href("/docs/privacy-local-state/")}><strong>Privacy and local state</strong><span>Exactly what stays in each browser record.</span></a>
          <a href={href("/docs/known-limitations/")}><strong>Known limitations</strong><span>Human, device, cultural, and release gaps kept visible.</span></a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <a class="brand" href={href("/")} aria-label="Nindova home">
        <img class="brand-lockup" src={href("/brand/nindova-logo-horizontal.svg")} alt="" width="202" height="64" />
      </a>
      <nav aria-label="Footer navigation">
        <a href={href("/docs/")}>Documentation</a>
        <a href={sourceUrl}>Source</a>
        <a href={releaseHistoryUrl}>Release history</a>
        <a href={href("/licenses/geist-OFL-1.1.txt")}>Notices</a>
      </nav>
      <p>Authored entertainment and behavioral design study · 18+ · Apache-2.0</p>
    </footer>
  </body>
</html>
